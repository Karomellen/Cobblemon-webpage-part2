# Copy to .env. Never commit .env.

# Server only, never sent to the browser
PORT=3001
MC_HOST=your.server.address
MC_PORT=25565
CLIENT_ORIGIN=http://localhost:5173
# Only if your status provider needs a key (mcstatus.io does not)
STATUS_API_KEY=

# Frontend, public. Only needed in production when the API is on another host
# VITE_API_BASE=https://api.example.com
