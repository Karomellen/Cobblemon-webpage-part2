# Copy to .env. Never commit .env.

# Server only, never sent to the browser
PORT=3001
MC_HOST=your.server.address
MC_PORT=25565
CLIENT_ORIGIN=http://localhost:5173,https://your-site.netlify.app
# Only if your status provider needs a key (mcstatus.io does not)
STATUS_API_KEY=

# Discord bot (keep DISCORD_BOT_TOKEN secret)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=1375955821870977054
ARCHIVE_CHANNEL_ID=1573804831481790614
ARCHIVE_ROLE_ID=1573804695833542777

# Supabase server credentials (never expose the service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Netlify build variable; set to the deployed API URL
# VITE_API_BASE=https://your-api.example.com
